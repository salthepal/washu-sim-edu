{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "washu-sim-edu",
  "compatibility_date": "2026-06-04",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "edu.wuemsim.org", "custom_domain": true },
    { "pattern": "edu.washuemsim.org", "custom_domain": true }
  ],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "washu-sim-edu-responses",
      "database_id": "e0d582c3-5b5b-4314-be31-e64033244091",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "12ce5c1cbbdc4926844c82bf450d42f0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CASE_FILES",
      "bucket_name": "washu-sim-edu-case-files"
    }
  ],
  "ratelimits": [
    {
      "name": "RESPONSE_IP_RATE_LIMITER",
      "namespace_id": "38174401",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "RESPONSE_LEARNER_RATE_LIMITER",
      "namespace_id": "38174402",
      "simple": { "limit": 12, "period": 60 }
    }
  ],
  "vars": {
    "TEAM_DOMAIN": "https://salph.cloudflareaccess.com",
    "POLICY_AUD": "0f7bb10b8959257c8e9c3bbca7603cf250e28a19406137df1d59a31d6fdb79e5",
    "FACULTY_EMAILS": "sphadnisuf@gmail.com"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client"
  }
}
