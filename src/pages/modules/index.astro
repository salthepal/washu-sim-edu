---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const allModules = await getCollection('modules', ({ data }) => !data.draft);
const modules = allModules.filter((m) => m.data.category === 'core').sort(
  (a, b) => a.data.order - b.data.order,
);
const additionalTopics = allModules.filter((m) => m.data.category === 'additional').sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title="Curriculum">
  <p class="eyebrow">Learning pathway</p>
  <h1 style="font-size:var(--step-3);">Curriculum</h1>
  <p class="lede">
    Worked in order, the modules take a resident from defining a focused
    learning objective, through writing and running the case, to prebriefing and
    debriefing with intention.
  </p>

  <ul class="clean" style="margin-top:2rem;">
    {
      modules.map((m) => (
        <li style="border-top:1px solid var(--line); padding:1.4rem 0;">
          <div style="display:flex; gap:1.4rem; align-items:baseline;">
            <span style="font-family:var(--mono); color:var(--coral); font-size:1rem;">
              {String(m.data.order).padStart(2, '0')}
            </span>
            <div style="flex:1;">
              <h2 style="font-size:var(--step-2); margin:0 0 0.3rem;">
                <a href={`/modules/${m.id}/`} style="text-decoration:none;">
                  {m.data.title}
                </a>
              </h2>
              <p style="margin:0; color:var(--ink-soft); max-width:var(--measure);">{m.data.summary}</p>
            </div>
          </div>
        </li>
      ))
    }
  </ul>

  <section style="margin-top:3rem; border-top:1px solid var(--line); padding-top:2rem;">
    <p class="eyebrow">Additional topics</p>
    <h2 style="font-size:var(--step-2); max-width:24ch;">For interested learners to explore next</h2>
    <p style="max-width:var(--measure); color:var(--ink-soft);">
      These topics are not part of the required core sequence, but they are
      useful extensions for residents who want to design more sophisticated
      cases or facilitate simulation more confidently.
    </p>

    <ul class="clean grid" style="margin-top:1.4rem;">
      {
        additionalTopics.map((topic) => (
          <li style="border:1px solid var(--line); border-radius:var(--radius); background:var(--paper);">
            <a href={`/modules/${topic.id}/`} style="display:block; padding:1rem; text-decoration:none; color:inherit;">
              <h3 style="font-size:var(--step-1); margin:0 0 0.35rem;">{topic.data.title}</h3>
              <p style="margin:0; color:var(--ink-soft); font-size:var(--step--1);">{topic.data.summary}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
