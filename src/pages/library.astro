---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';

export const prerender = true;

function hasZoteroGroupId(): boolean {
  if (process.env.ZOTERO_GROUP_ID) return true;

  const envPath = resolve(process.cwd(), '.env');
  if (!existsSync(envPath)) return false;

  return readFileSync(envPath, 'utf8')
    .split(/\r?\n/)
    .some((line) => /^\s*ZOTERO_GROUP_ID\s*=\s*\S+/.test(line));
}

async function getOptionalBibliography(): Promise<CollectionEntry<'bibliography'>[]> {
  if (!hasZoteroGroupId()) return [];
  return getCollection('bibliography');
}

function formatCitationHtml(bibHtml: string): string {
  return bibHtml
    .replace(/<div class="csl-left-margin"[^>]*>[\s\S]*?<\/div>/g, '')
    .replace(/\sstyle="margin:\s*0\s*\.4em\s*0\s*1\.5em;?"/g, '');
}

const docs = await getCollection('documents');
const bib = (await getOptionalBibliography()).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);

const kinds = [...new Set(docs.map((d) => d.data.kind))].sort();
---

<Base title="Library">
  <p class="eyebrow">Resources</p>
  <h1 style="font-size:var(--step-3);">Library</h1>
  <p class="lede">
    Curated documents, tools, and templates, plus the full reading list. Texts
    link to institutionally-licensed copies rather than re-hosted files.
  </p>

  <section style="margin-top:2.5rem;">
    <h2 style="font-size:var(--step-2);">Documents &amp; tools</h2>
    {
      kinds.map((kind) => (
        <div style="margin-top:1.5rem;">
          <p class="eyebrow">{kind.replace('-', ' ')}</p>
          <ul class="clean" style="display:flex; flex-direction:column; gap:0.7rem;">
            {docs
              .filter((d) => d.data.kind === kind)
              .map((d) => (
                <li style="border-bottom:1px solid var(--line); padding-bottom:0.7rem;">
                  <a href={d.data.href} style="font-size:var(--step-0);">
                    {d.data.title} ↗
                  </a>
                  {d.data.source && (
                    <span style="font-family:var(--mono); font-size:0.7rem; color:var(--ink-soft);">
                      {' '}· {d.data.source}
                    </span>
                  )}
                  {d.data.note && (
                    <p style="margin:0.2rem 0 0; color:var(--ink-soft); font-size:var(--step--1);">
                      {d.data.note}
                    </p>
                  )}
                </li>
              ))}
          </ul>
        </div>
      ))
    }
  </section>

  <section style="margin-top:3rem;">
    <h2 style="font-size:var(--step-2);">Bibliography</h2>
    {
      bib.length === 0 ? (
        <p style="color:var(--ink-soft);">
          Empty until the Zotero group library is wired up. Set
          <code>ZOTERO_GROUP_ID</code> (and <code>ZOTERO_API_KEY</code> for a
          private group) in the Pages build environment.
        </p>
      ) : (
        <ol style="display:flex; flex-direction:column; gap:0.9rem; margin:1rem 0 0; padding:0; list-style:none;">
          {bib.map((i, index) => (
            <li style="display:grid; grid-template-columns:2rem minmax(0, 1fr); gap:0.5rem; font-size:var(--step--1); line-height:1.5;">
              <span aria-hidden="true">{index + 1}.</span>
              <div set:html={formatCitationHtml(i.data.bibHtml)} />
            </li>
          ))}
        </ol>
      )
    }
  </section>
</Base>
