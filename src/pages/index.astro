---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const modules = (await getCollection('modules', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const reviewedCount = (await getCollection('simCases', ({ data }) => data.status === 'peer-reviewed'))
  .length;
---

<Base title="Home">
  <section style="margin-bottom:3rem;">
    <p class="eyebrow">Emergency Medicine Residency · Education Rotation</p>
    <h1 style="font-size:var(--step-4); max-width:18ch;">
      Build a simulation case worth teaching.
    </h1>
    <p class="lede" style="margin-top:1rem;">
      This site supports the simulation component of the Education Rotation.
      Use it to learn the basics of case design and debriefing, study strong
      exemplars, and shape your own case into a clear teaching experience.
    </p>
    <div style="display:flex; gap:1rem; margin-top:1.8rem; flex-wrap:wrap;">
      <a
        href="/modules/"
        style="font-family:var(--mono); font-size:0.8rem; letter-spacing:0.05em; text-transform:uppercase; text-decoration:none; background:var(--petrol); color:var(--paper); padding:0.7rem 1.3rem; border-radius:var(--radius);"
        >Start the sim modules →</a
      >
      <a
        href="/cases/"
        style="font-family:var(--mono); font-size:0.8rem; letter-spacing:0.05em; text-transform:uppercase; text-decoration:none; color:var(--ink); border:1px solid var(--line-strong); padding:0.7rem 1.3rem; border-radius:var(--radius);"
        >Review {reviewedCount} case exemplar{reviewedCount === 1 ? '' : 's'}</a
      >
    </div>
  </section>

  <section>
    <p class="eyebrow">How to use this site</p>
    <h2 style="font-size:var(--step-2); max-width:24ch;">Build a case with a teaching argument</h2>
    <p style="max-width:var(--measure); color:var(--ink-soft);">
      Work through the modules in order, then compare your draft against the
      exemplar cases. By the end of the rotation, you should have one simulation
      case with a defensible teaching objective, an intentional scenario
      structure, and a debrief plan that matches what you wanted learners to
      practice.
    </p>
    <ul class="clean" style="border-top:1px solid var(--line);">
      {
        modules.map((m) => (
          <li style="border-bottom:1px solid var(--line);">
            <a
              href={`/modules/${m.id}/`}
              style="display:flex; gap:1.4rem; align-items:baseline; padding:1.1rem 0; text-decoration:none; color:inherit;"
            >
              <span style="font-family:var(--mono); color:var(--coral); font-size:0.9rem;">
                {String(m.data.order).padStart(2, '0')}
              </span>
              <span style="flex:1;">
                <span style="font-family:var(--display); font-size:var(--step-1); display:block;">
                  {m.data.title}
                </span>
                <span style="color:var(--ink-soft); font-size:var(--step--1);">{m.data.summary}</span>
              </span>
              <span style="color:var(--ink-soft);">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
