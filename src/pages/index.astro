---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const allModules = await getCollection('modules', ({ data }) => !data.draft);
const modules = allModules.filter((m) => m.data.category === 'core').sort(
  (a, b) => a.data.order - b.data.order,
);
const additionalTopics = allModules.filter((m) => m.data.category === 'additional').sort(
  (a, b) => a.data.order - b.data.order,
);
const reviewedCount = (await getCollection('simCases', ({ data }) => data.status === 'peer-reviewed'))
  .length;
---

<Base title="Home">
  <section class="home-hero">
    <h1 style="font-size:var(--step-4); max-width:18ch;">
      Build a simulation case.
    </h1>
    <p class="lede" style="margin-top:1rem;">
      A focused guide to the simulation portion of the Education Rotation,
      from case design to debriefing.
    </p>
    <div class="action-row">
      <a href="/modules/" class="btn">Start the sim modules →</a>
      <a href="/cases/" class="btn ghost">Review {reviewedCount} case exemplar{reviewedCount === 1 ? '' : 's'}</a>
    </div>
  </section>

  <section>
    <p class="eyebrow">How to use this site</p>
    <h2 style="font-size:var(--step-2); max-width:24ch;">Leave with a case ready to run</h2>
    <p style="max-width:var(--measure); color:var(--ink-soft);">
      Use the required modules to shape your teaching objective, scenario
      structure, and debrief plan. The exemplar cases are there as reference
      points while you revise your draft.
    </p>
    <ul class="clean" style="border-top:1px solid var(--line);">
      {
        modules.map((m) => (
          <li style="border-bottom:1px solid var(--line);">
            <a
              href={`/modules/${m.id}/`}
              style="display:flex; gap:1.4rem; align-items:baseline; padding:1.1rem 0; text-decoration:none; color:inherit;"
            >
              <span style="font-family:var(--mono); color:var(--coral); font-size:0.9rem;">
                {String(m.data.order).padStart(2, '0')}
              </span>
              <span style="flex:1;">
                <span style="font-family:var(--display); font-size:var(--step-1); display:block;">
                  {m.data.title}
                </span>
                <span style="color:var(--ink-soft); font-size:var(--step--1);">{m.data.summary}</span>
              </span>
              <span style="color:var(--ink-soft);">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section style="margin-top:3rem; border-top:1px solid var(--line); padding-top:2rem;">
    <p class="eyebrow">Additional topics</p>
    <h2 style="font-size:var(--step-2); max-width:24ch;">After the core modules</h2>
    <p style="max-width:var(--measure); color:var(--ink-soft);">
      Optional topics that extend case design, facilitation, and assessment
      beyond the required sequence.
    </p>
    <ul class="clean grid" style="margin-top:1.4rem;">
      {
        additionalTopics.map((topic) => (
          <li style="border:1px solid var(--line); border-radius:var(--radius); background:var(--paper);">
            <a href={`/modules/${topic.id}/`} style="display:block; padding:1rem; text-decoration:none; color:inherit;">
              <h3 style="font-size:var(--step-1); margin:0 0 0.35rem;">{topic.data.title}</h3>
              <p style="margin:0; color:var(--ink-soft); font-size:var(--step--1);">{topic.data.summary}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
