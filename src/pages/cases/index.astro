---
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const all = await getCollection('simCases');
---

<Base title="Exemplars">
  <p class="eyebrow">Case library</p>
  <h1 style="font-size:var(--step-3);">Exemplar sim cases</h1>
  <p class="lede">
    Exemplar cases, each presented with <em>why</em> it teaches well. Current
    source cases are adapted from EM Sim Cases with attribution and downloadable
    facilitator packets.
  </p>

  <div class="grid" style="margin-top:2.5rem;">
    {all.map((entry) => <CaseCard entry={entry} />)}
  </div>
</Base>
