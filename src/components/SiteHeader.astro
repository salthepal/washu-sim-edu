---
const path = Astro.url.pathname;
const links = [
  { href: '/modules/', label: 'Curriculum' },
  { href: '/cases/', label: 'Exemplars' },
  { href: '/library/', label: 'Library' },
];
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header wrap">
  <a href="/" class="site-mark" aria-label="WUEM Sim Edu (Beta) home">
    <span class="site-mark__unit">WUEM</span>
    <span class="site-mark__name-row">
      <span class="site-mark__name">Sim Edu</span>
      <span class="site-mark__beta">Beta</span>
    </span>
  </a>
  <nav class="site-nav" aria-label="Primary navigation">
    {
      links.map((l) => (
        <a
          href={l.href}
          class={isActive(l.href) ? 'site-nav__link is-active' : 'site-nav__link'}
        >
          {l.label}
        </a>
      ))
    }
    <a href="https://wuemsim.org/" class="site-nav__home">Return to home</a>
    <button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false">
      <span class="theme-toggle__icon" aria-hidden="true">☾</span>
      <span class="theme-toggle__text">Dark</span>
    </button>
  </nav>
</header>
