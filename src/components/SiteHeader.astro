---
const path = Astro.url.pathname;
const links = [
  { href: '/modules/', label: 'Curriculum' },
  { href: '/cases/', label: 'Exemplars' },
  { href: '/library/', label: 'Library' },
];
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header wrap">
  <a href="/" class="site-mark" aria-label="WashU Emergency Medicine Simulation Education home">
    <span class="site-mark__unit">WashU Emergency Medicine</span>
    <span class="site-mark__name">Simulation Education</span>
  </a>
  <nav class="site-nav" aria-label="Primary navigation">
    {
      links.map((l) => (
        <a
          href={l.href}
          class={isActive(l.href) ? 'site-nav__link is-active' : 'site-nav__link'}
        >
          {l.label}
        </a>
      ))
    }
  </nav>
</header>
