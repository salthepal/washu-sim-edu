---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';

interface Props {
  tags: string[];
  heading?: string;
}
const { tags, heading = 'Reading list' } = Astro.props;

function hasZoteroGroupId(): boolean {
  if (process.env.ZOTERO_GROUP_ID) return true;

  const envPath = resolve(process.cwd(), '.env');
  if (!existsSync(envPath)) return false;

  return readFileSync(envPath, 'utf8')
    .split(/\r?\n/)
    .some((line) => /^\s*ZOTERO_GROUP_ID\s*=\s*\S+/.test(line));
}

async function getOptionalBibliography(): Promise<CollectionEntry<'bibliography'>[]> {
  if (!hasZoteroGroupId()) return [];

  try {
    return await getCollection('bibliography');
  } catch (error) {
    if (error instanceof Error && error.message.includes('does not exist or is empty')) {
      return [];
    }
    throw error;
  }
}

const all = await getOptionalBibliography();
const items =
  tags.length === 0
    ? []
    : all.filter((i) => i.data.tags.some((t) => tags.includes(t)));
---

{
  items.length > 0 && (
    <section style="margin-top:2.5rem;">
      <p class="eyebrow">{heading}</p>
      <ul class="clean" style="display:flex; flex-direction:column; gap:0.9rem;">
        {items.map((i) => (
          <li style="font-size:var(--step--1); line-height:1.5;">
            <span set:html={i.data.bibHtml} />
            {i.data.url && (
              <>
                {' '}
                <a href={i.data.url} style="font-family:var(--mono); font-size:0.72rem;">
                  link ↗
                </a>
              </>
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}
