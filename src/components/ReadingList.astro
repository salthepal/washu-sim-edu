---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { formatCitationHtml, sortBibliography } from '../lib/zotero';

interface Props {
  tags: string[];
  heading?: string;
}
const { tags, heading = 'Reading list' } = Astro.props;

async function getOptionalBibliography(): Promise<CollectionEntry<'bibliography'>[]> {
  try {
    return await getCollection('bibliography');
  } catch (error) {
    if (error instanceof Error && error.message.includes('does not exist or is empty')) {
      return [];
    }
    throw error;
  }
}

const all = await getOptionalBibliography();
const items =
  tags.length === 0
    ? []
    : sortBibliography(all.filter((i) => i.data.tags.some((t) => tags.includes(t))));
---

{
  items.length > 0 && (
    <section style="margin-top:2.5rem;">
      <p class="eyebrow">{heading}</p>
      <ol style="display:flex; flex-direction:column; gap:0.9rem; padding-left:2rem; margin:0;">
        {items.map((i) => (
          <li style="padding-left:0.25rem; font-size:var(--step--1); line-height:1.5;">
            <div>
              <div set:html={formatCitationHtml(i.data.bibHtml)} />
              {i.data.url && (
                <a href={i.data.url} style="font-family:var(--mono); font-size:0.72rem;">
                  link ↗
                </a>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>
  )
}
