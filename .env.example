# Optional build-time Zotero overrides. The public WUEM Zotero group and AMA
# style are built in, so a fresh checkout includes the bibliography.

# Zotero group library ID (the number in the group's URL).
ZOTERO_GROUP_ID=6590613

# Read-only API key. Only needed if the group library is private.
ZOTERO_API_KEY=

# CSL style slug for rendered citations. Default: american-medical-association
# Other options: apa, vancouver, chicago-author-date, nlm
ZOTERO_STYLE=american-medical-association
