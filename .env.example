# Copy to `.env` for local builds, or set these as Build environment variables
# in the Cloudflare Pages dashboard for production. None are required for a
# first build — the bibliography is simply empty until ZOTERO_GROUP_ID is set.

# Zotero GROUP library id (the number in the group's URL).
ZOTERO_GROUP_ID=6590613

# Read-only API key. Only needed if the group library is private.
ZOTERO_API_KEY=

# CSL style slug for rendered citations. Default: american-medical-association
# Other options: apa, vancouver, chicago-author-date, nlm
ZOTERO_STYLE=american-medical-association

# Cloudflare Access validation is only needed for the optional faculty CSV
# export endpoint. Learner submissions use an anonymous browser cookie.
TEAM_DOMAIN=https://salph.cloudflareaccess.com
POLICY_AUD=0f7bb10b8959257c8e9c3bbca7603cf250e28a19406137df1d59a31d6fdb79e5

# Comma-separated email allowlist for CSV export.
FACULTY_EMAILS=sphadnisuf@gmail.com
